[Unit]
Description=llama.cpp server — Qwen3.6-27B Q4_K_M
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/opt/llama.cpp

# Thinking disabled so the model answers directly under the benchmark's
# small token budgets (matches how the other Qwen models are run).
Environment=LLAMA_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}

ExecStart=/opt/llama.cpp/build/bin/llama-server \
    -m /models/Qwen3.6-27B-Q4_K_M.gguf \
    --alias Qwen3.6-27B \
    --host 0.0.0.0 \
    --port 8001 \
    -np 1 \
    -fa on \
    --no-mmap \
    -ctk q8_0 \
    -ctv q8_0 \
    --ctx-size 32768 \
    -ngl 99 \
    --temp 0.6 \
    --top-k 20 \
    --top-p 0.95 \
    --min-p 0.0 \
    --cache-reuse 256 \
    --reasoning off

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server-qwen3.6-27b

[Install]
WantedBy=multi-user.target
